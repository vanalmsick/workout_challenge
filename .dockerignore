# Allow-list style .dockerignore.
#
# IMPORTANT: .dockerignore patterns are NOT .gitignore patterns. A bare pattern
# like `node_modules` matches only ./node_modules at the context root - it does
# NOT match src-frontend/node_modules at any depth. The previous version of this
# file was a copy of .gitignore, which meant ~750 MB of src-frontend/node_modules
# plus .git and src-frontend/build were uploaded to the builder on every build.
#
# So: ignore everything, then re-add only what the Dockerfile actually COPYs.
# If you add a new COPY to the Dockerfile, add an exception for it here.

*

!nginx.conf
!nginx-security-headers.conf
!supervisord.conf
!src-backend/
!src-frontend/

# ---- re-exclude heavy or generated paths inside the allowed directories ----

# 738 MB of dependencies - reinstalled from package-lock.json inside the image
src-frontend/node_modules/
# regenerated by `npm run build` in the frontend stage
src-frontend/build/

# runtime volume (migrations + sqlite db) - must not be baked into the image
src-backend/data/
# regenerated by `manage.py collectstatic` in the final stage
src-backend/static/

**/__pycache__/
**/*.py[cod]
**/*.so
**/.pytest_cache/
**/.mypy_cache/
**/.coverage
**/htmlcov/

# ---- secrets and local noise ----
**/.env
**/.env.*
**/local_settings.py
**/*.log
**/*.rdb
**/celerybeat-schedule
**/celerybeat.pid
**/db.sqlite3
**/db.sqlite3-journal
**/.DS_Store
**/*.backup.*
**/*.back.*
