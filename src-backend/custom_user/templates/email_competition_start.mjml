<mjml>
  <!-- Written with https://mjml.io/ - compile with: npx mjml email_competition_start.mjml -o email_competition_start.html -->
  <mj-head>
    <mj-title>Your competition starts tomorrow</mj-title>
    <mj-preview>"{{ competition.name }}" kicks off tomorrow. Here is how the goals work and how points are earned.</mj-preview>
    <mj-raw>
      {% load humanize %}
      <meta name="color-scheme" content="light">
      <meta name="supported-color-schemes" content="light">
    </mj-raw>
    <mj-attributes>
      <mj-all font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Ubuntu, Helvetica, Arial, sans-serif" />
      <mj-text font-size="15px" line-height="1.6" color="#1F2937" padding="0px 28px" />
      <mj-section background-color="#ffffff" padding="0px" />
      <mj-column padding="0px" />
      <mj-divider border-color="#E5E7EB" border-width="1px" padding="22px 28px" />
      <mj-button background-color="#075985" color="#ffffff" border-radius="999px" font-size="13px" font-weight="700" inner-padding="13px 30px" padding="0px" />
    </mj-attributes>
  </mj-head>

  <mj-body background-color="#E1E8ED">
    <!-- ============ Hero ============ -->
    <mj-hero mode="fixed-height" height="200px" background-url="{{ MAIN_HOST }}/running_email.jpg" background-color="#075985" padding="0px">
      <mj-text align="center" css-class="no-invert" padding="46px 20px 0px">
        <div style="font-size:11px;font-weight:700;letter-spacing:3px;text-transform:uppercase;color:#CFE3F0;text-shadow:0 1px 4px rgba(0,0,0,0.45);">Ready, set, go</div>
        <div style="font-size:30px;font-weight:700;line-height:1.2;color:#ffffff;padding-top:4px;text-shadow:0 2px 8px rgba(0,0,0,0.45);">Workout Challenge</div>
      </mj-text>
      <mj-button href="{{ MAIN_HOST }}/login" background-color="#ffffff" color="#075985" padding="18px 20px 0px">Open the app</mj-button>
    </mj-hero>

    <!-- ============ Intro ============ -->
    <mj-section padding="30px 0px 0px">
      <mj-column>
        <mj-text>
          <p style="margin:0 0 14px;">Hi {{ first_name }},</p>
        </mj-text>
        <mj-text padding="0px 28px">
          <table cellpadding="0" cellspacing="0" border="0" width="100%" role="presentation" style="background-color:#F4F7FA;border-radius:10px;">
            <tr>
              <td style="padding:16px 18px;font-size:15px;line-height:1.5;color:#1F2937;">
                <span style="font-size:18px;">&#127937;</span>&nbsp;&nbsp;<b>{{ competition.name }}</b> kicks off tomorrow.
                <div style="font-size:13px;color:#5B6875;padding-top:4px;">Give it a strong start and build momentum &ndash; your best is waiting.</div>
              </td>
            </tr>
          </table>
        </mj-text>
        <mj-text padding="16px 28px 0px">
          <p style="margin:0;">Before you begin, here is how the goals work and how points are earned.</p>
        </mj-text>
        <mj-divider />
      </mj-column>
    </mj-section>

    <!-- ============ How points work ============ -->
    <mj-section padding="0px">
      <mj-column>
        <mj-text padding="0px 28px">
          <div style="font-size:17px;font-weight:700;color:#075985;padding-bottom:10px;">How to earn activity points</div>
          <table cellpadding="0" cellspacing="0" border="0" width="100%" role="presentation" style="font-size:14px;line-height:1.55;color:#1F2937;">
            <tr>
              <td width="26" valign="top" style="padding:0 0 10px;font-size:13px;font-weight:700;color:#075985;">1</td>
              <td valign="top" style="padding:0 0 10px;">Every competition sets its own activity goals. You earn <b>1 point for every 1%</b> of a goal you complete.</td>
            </tr>
            <tr>
              <td width="26" valign="top" style="padding:0 0 10px;font-size:13px;font-weight:700;color:#075985;">2</td>
              <td valign="top" style="padding:0 0 10px;">A 100&nbsp;minute goal and a 50&nbsp;minute workout means 50&nbsp;points.</td>
            </tr>
            <tr>
              <td width="26" valign="top" style="font-size:13px;font-weight:700;color:#075985;">3</td>
              <td valign="top">Some goals carry minimum or maximum limits. Activities outside them earn no points and are marked with an asterisk&nbsp;(*). Hover a goal in the app to see its limits.</td>
            </tr>
          </table>
        </mj-text>
        <mj-divider />
      </mj-column>
    </mj-section>

    <!-- ============ Activity goals ============ -->
    <mj-section padding="0px 0px 4px">
      <mj-column>
        <mj-text padding="0px 28px">
          <div style="font-size:17px;font-weight:700;color:#075985;padding-bottom:12px;">Activity goals</div>

          {% for goal in goals %}
          <table cellpadding="0" cellspacing="0" border="0" width="100%" role="presentation" style="background-color:#F4F7FA;border-radius:10px;">
            <tr>
              <td style="padding:16px 18px;">
                <table cellpadding="0" cellspacing="0" border="0" width="100%" role="presentation">
                  <tr>
                    <td valign="top" style="font-size:15px;font-weight:700;color:#1F2937;line-height:1.35;">{{ goal.name }}</td>
                    <td valign="top" align="right" style="font-size:15px;font-weight:700;color:#075985;line-height:1.35;white-space:nowrap;">{{ goal.goal|floatformat:0|intcomma }} {{ goal.metric }}<span style="font-size:12px;font-weight:400;color:#8A97A4;"> / {{ goal.period }}</span></td>
                  </tr>
                </table>
                {% if goal.min_per_workout > 0 or goal.max_per_workout > 0 or goal.min_per_day > 0 or goal.max_per_day > 0 or goal.min_per_week > 0 or goal.max_per_week > 0 %}
                <div style="padding-top:10px;font-size:11px;line-height:2;color:#5B6875;">
                  <span style="font-weight:700;letter-spacing:0.8px;text-transform:uppercase;color:#8A97A4;">Limits</span>&nbsp;
                  {% if goal.min_per_workout > 0 %}<span style="background-color:#ffffff;border:1px solid #DDE5EC;border-radius:999px;padding:3px 9px;white-space:nowrap;">min {{ goal.min_per_workout|floatformat:0|intcomma }} {{ goal.metric }} / workout</span>&nbsp;{% endif %}
                  {% if goal.max_per_workout > 0 %}<span style="background-color:#ffffff;border:1px solid #DDE5EC;border-radius:999px;padding:3px 9px;white-space:nowrap;">max {{ goal.max_per_workout|floatformat:0|intcomma }} {{ goal.metric }} / workout</span>&nbsp;{% endif %}
                  {% if goal.min_per_day > 0 %}<span style="background-color:#ffffff;border:1px solid #DDE5EC;border-radius:999px;padding:3px 9px;white-space:nowrap;">min {{ goal.min_per_day|floatformat:0|intcomma }} {{ goal.metric }} / day</span>&nbsp;{% endif %}
                  {% if goal.max_per_day > 0 %}<span style="background-color:#ffffff;border:1px solid #DDE5EC;border-radius:999px;padding:3px 9px;white-space:nowrap;">max {{ goal.max_per_day|floatformat:0|intcomma }} {{ goal.metric }} / day</span>&nbsp;{% endif %}
                  {% if goal.min_per_week > 0 %}<span style="background-color:#ffffff;border:1px solid #DDE5EC;border-radius:999px;padding:3px 9px;white-space:nowrap;">min {{ goal.min_per_week|floatformat:0|intcomma }} {{ goal.metric }} / week</span>&nbsp;{% endif %}
                  {% if goal.max_per_week > 0 %}<span style="background-color:#ffffff;border:1px solid #DDE5EC;border-radius:999px;padding:3px 9px;white-space:nowrap;">max {{ goal.max_per_week|floatformat:0|intcomma }} {{ goal.metric }} / week</span>{% endif %}
                </div>
                {% endif %}
              </td>
            </tr>
          </table>
          <div style="height:10px;line-height:10px;font-size:0;">&nbsp;</div>
          {% empty %}
          <div style="font-size:14px;color:#5B6875;">No activity goals have been set up yet.</div>
          {% endfor %}
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-raw> {% if goal_equalizer_note %} </mj-raw>
    <!-- ============ Goal equalizer ============ -->
    <mj-section padding="18px 0px 0px">
      <mj-column>
        <mj-divider padding="0px 28px 24px" />
      </mj-column>
    </mj-section>
    <mj-section background-color="#075985" padding="30px 0px">
      <mj-column>
        <mj-text align="center" color="#ffffff" padding="0px 28px">
          <div style="font-size:11px;font-weight:700;letter-spacing:2.4px;text-transform:uppercase;color:#9FC7DE;">Make it fair</div>
          <div style="font-size:19px;font-weight:700;line-height:1.35;color:#ffffff;padding-top:8px;">Turn on the Goal Equalizer</div>
        </mj-text>
        <mj-text align="center" color="#D4E4EE" font-size="13px" padding="14px 34px 0px">
          Everyone has a different <b style="color:#ffffff;">basal metabolic rate</b>, driven by age, gender, height and weight. The default goals are calibrated for a 35&nbsp;year old, 1.8&nbsp;m tall man. Personalise yours with the &ldquo;Goal Equalizer&rdquo; just below your personal settings.
        </mj-text>
        <mj-button href="{{ MAIN_HOST }}/login" background-color="#ffffff" color="#075985" padding="22px 28px 0px">Adjust my goals</mj-button>
      </mj-column>
    </mj-section>
    <mj-raw> {% endif %} </mj-raw>

    <!-- ============ Sign off ============ -->
    <mj-section padding="0px 0px 30px">
      <mj-column>
        <mj-raw> {% if not goal_equalizer_note %} </mj-raw>
        <mj-divider />
        <mj-raw> {% endif %} </mj-raw>
        <mj-text padding="26px 28px 0px">
          <p style="margin:0 0 16px;">Log in to see who else is taking part, pick your team and fine-tune your goals.</p>
        </mj-text>
        <mj-button href="{{ MAIN_HOST }}/login" padding="0px 28px" align="left">Open the app</mj-button>
        <mj-text padding="22px 28px 0px">
          <p style="margin:0 0 4px;">Enjoy the competition &ndash; good luck!</p>
          <p style="margin:0;color:#5B6875;font-size:14px;">The Workout Challenge</p>
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- ============ Footer ============ -->
    <mj-section background-color="#E1E8ED" padding="22px 0px 26px">
      <mj-column>
        <mj-text align="center" font-size="12px" line-height="1.7" color="#7A8794">
          <span style="font-weight:700;color:#5B6875;">Workout Challenge</span><br />
          Any issues? <a href="mailto:{{ EMAIL_REPLY_TO }}" style="color:#075985;text-decoration:none;font-weight:600;">Send us an email</a> &nbsp;&middot;&nbsp; <a href="https://github.com/vanalmsick/workout_challenge" style="color:#075985;text-decoration:none;font-weight:600;">Source code</a>
        </mj-text>
      </mj-column>
    </mj-section>

  </mj-body>
</mjml>
