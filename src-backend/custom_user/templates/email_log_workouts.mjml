<mjml>
  <!-- Written with https://mjml.io/ - compile with: npx mjml email_log_workouts.mjml -o email_log_workouts.html -->
  <mj-head>
    <mj-title>Log last week's workouts</mj-title>
    <mj-preview>New week, new gains. Get last week logged before the leaderboard goes out this afternoon.</mj-preview>
    <mj-raw>
      {% load humanize %}
      <meta name="color-scheme" content="light">
      <meta name="supported-color-schemes" content="light">
    </mj-raw>
    <mj-attributes>
      <mj-all font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Ubuntu, Helvetica, Arial, sans-serif" />
      <mj-text font-size="15px" line-height="1.6" color="#1F2937" padding="0px 28px" />
      <mj-section background-color="#ffffff" padding="0px" />
      <mj-column padding="0px" />
      <mj-divider border-color="#E5E7EB" border-width="1px" padding="22px 28px" />
      <mj-button background-color="#075985" color="#ffffff" border-radius="999px" font-size="13px" font-weight="700" inner-padding="13px 30px" padding="0px" />
    </mj-attributes>
  </mj-head>

  <mj-body background-color="#E1E8ED">

    <!-- ============ Hero ============ -->
    <mj-hero mode="fixed-height" height="200px" background-url="{{ MAIN_HOST }}/running_email.jpg" background-color="#075985" padding="0px">
      <mj-text align="center" css-class="no-invert" padding="46px 20px 0px">
        <div style="font-size:11px;font-weight:700;letter-spacing:3px;text-transform:uppercase;color:#CFE3F0;text-shadow:0 1px 4px rgba(0,0,0,0.45);">Time to log</div>
        <div style="font-size:30px;font-weight:700;line-height:1.2;color:#ffffff;padding-top:4px;text-shadow:0 2px 8px rgba(0,0,0,0.45);">Workout Challenge</div>
      </mj-text>
      <mj-button href="{{ MAIN_HOST }}/dashboard" background-color="#ffffff" color="#075985" padding="18px 20px 0px">Open the app</mj-button>
    </mj-hero>

    <!-- ============ Intro ============ -->
    <mj-section padding="30px 0px 0px">
      <mj-column>
        <mj-text>
          <p style="margin:0 0 14px;">Hi {{ first_name }},</p>
          <p style="margin:0 0 14px;">New week, new gains.</p>
          {% if link_strava_note %}
          <p style="margin:0;">But first &ndash; time to <b>log last week's workouts and steps</b> before the leaderboard goes out this afternoon.</p>
          {% else %}
          <p style="margin:0;">But first &ndash; time to <b>log last week's steps</b>. Your workouts are already imported, but Strava does not track steps. The leaderboard goes out this afternoon.</p>
          {% endif %}
        </mj-text>
        <mj-divider />
      </mj-column>
    </mj-section>

    <!-- ============ Last workouts ============ -->
    <mj-section padding="0px 0px 4px">
      <mj-column>
        <mj-text padding="0px 28px">
          <div style="font-size:17px;font-weight:700;color:#075985;padding-bottom:12px;">&#9201;&#65039;&nbsp; Your last workouts</div>
          <table cellpadding="0" cellspacing="0" border="0" width="100%" role="presentation" style="font-size:14px;">
            <tr>
              <td style="padding:0 0 6px;font-size:11px;font-weight:700;letter-spacing:1.2px;text-transform:uppercase;color:#8A97A4;">When</td>
              <td align="right" style="padding:0 0 6px;font-size:11px;font-weight:700;letter-spacing:1.2px;text-transform:uppercase;color:#8A97A4;">What</td>
            </tr>
            {% for item in last_workouts %}
            <tr>
              <td valign="top" style="padding:9px 0;border-top:1px solid #EDF1F5;color:#5B6875;white-space:nowrap;">{{ item.start_datetime|date:"D, j M" }}<span style="color:#A7B2BC;"> &middot; {{ item.start_datetime|date:"H:i" }}</span></td>
              <td valign="top" align="right" style="padding:9px 0;border-top:1px solid #EDF1F5;color:#1F2937;">{% if item.sport_type == "Steps" %}{{ item.steps|intcomma }} steps{% else %}<span style="color:#5B6875;">{{ item.duration_minutes|intcomma }} min</span> <b>{{ item.get_sport_type_display }}</b>{% endif %}</td>
            </tr>
            {% empty %}
            <tr>
              <td colspan="2" style="padding:14px 0;border-top:1px solid #EDF1F5;font-size:14px;color:#8A97A4;">Nothing logged yet &ndash; your first workout is one tap away.</td>
            </tr>
            {% endfor %}
          </table>
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section padding="20px 0px 0px">
      <mj-column>
        <mj-button href="{{ MAIN_HOST }}/dashboard" padding="0px 28px" align="left">{% if link_strava_note %}Log workouts &amp; steps{% else %}Log steps{% endif %}</mj-button>
      </mj-column>
    </mj-section>

    <mj-raw> {% if link_strava_note %} </mj-raw>
    <!-- ============ Link Strava ============ -->
    <mj-section padding="24px 0px 0px">
      <mj-column>
        <mj-divider padding="0px 28px 24px" />
      </mj-column>
    </mj-section>
    <mj-section background-color="#075985" padding="30px 0px">
      <mj-column>
        <mj-text align="center" color="#ffffff" padding="0px 28px">
          <div style="font-size:11px;font-weight:700;letter-spacing:2.4px;text-transform:uppercase;color:#9FC7DE;">Recommended</div>
          <div style="font-size:19px;font-weight:700;line-height:1.35;color:#ffffff;padding-top:8px;">Connect Strava and skip manual logging</div>
        </mj-text>
        <mj-text align="center" color="#D4E4EE" font-size="13px" padding="14px 34px 0px">
          Every day at 4&nbsp;AM your workouts are imported automatically. To respect your privacy we only ever read the essentials: sport type, start time &amp; duration, workout id, distance, kcal, kJ and average watts.
        </mj-text>
        <mj-button href="{{ MAIN_HOST }}/strava/link" background-color="#ffffff" color="#075985" padding="22px 28px 0px">Link Strava</mj-button>
      </mj-column>
    </mj-section>
    <mj-raw> {% endif %} </mj-raw>

    <!-- ============ Sign off ============ -->
    <mj-section padding="0px 0px 30px">
      <mj-column>
        <mj-raw> {% if not link_strava_note %} </mj-raw>
        <mj-divider />
        <mj-raw> {% endif %} </mj-raw>
        <mj-text padding="26px 28px 0px">
          <p style="margin:0 0 4px;">Enjoy the competition &ndash; good luck!</p>
          <p style="margin:0;color:#5B6875;font-size:14px;">The Workout Challenge</p>
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- ============ Footer ============ -->
    <mj-section background-color="#E1E8ED" padding="22px 0px 26px">
      <mj-column>
        <mj-text align="center" font-size="12px" line-height="1.7" color="#7A8794">
          <span style="font-weight:700;color:#5B6875;">Workout Challenge</span><br />
          Any issues? <a href="mailto:{{ EMAIL_REPLY_TO }}" style="color:#075985;text-decoration:none;font-weight:600;">Send us an email</a> &nbsp;&middot;&nbsp; <a href="https://github.com/vanalmsick/workout_challenge" style="color:#075985;text-decoration:none;font-weight:600;">Source code</a>
        </mj-text>
      </mj-column>
    </mj-section>

  </mj-body>
</mjml>
