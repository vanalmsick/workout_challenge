<mjml>
  <!-- Written with https://mjml.io/ - compile with: npx mjml email_password_reset.mjml -o email_password_reset.html -->
  <mj-head>
    <mj-title>Reset your password</mj-title>
    <mj-preview>Use the link below to choose a new password. It stays valid for 10 minutes.</mj-preview>
    <mj-raw>
      <meta name="color-scheme" content="light">
      <meta name="supported-color-schemes" content="light">
    </mj-raw>
    <mj-attributes>
      <mj-all font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Ubuntu, Helvetica, Arial, sans-serif" />
      <mj-text font-size="15px" line-height="1.6" color="#1F2937" padding="0px 28px" />
      <mj-section background-color="#ffffff" padding="0px" />
      <mj-column padding="0px" />
      <mj-divider border-color="#E5E7EB" border-width="1px" padding="22px 28px" />
      <mj-button background-color="#075985" color="#ffffff" border-radius="999px" font-size="13px" font-weight="700" inner-padding="13px 30px" padding="0px" />
    </mj-attributes>
  </mj-head>

  <mj-body background-color="#E1E8ED">

    <!-- ============ Hero ============ -->
    <mj-hero mode="fixed-height" height="160px" background-url="{{ MAIN_HOST }}/running_email.jpg" background-color="#075985" padding="0px">
      <mj-text align="center" css-class="no-invert" padding="52px 20px 0px">
        <div style="font-size:11px;font-weight:700;letter-spacing:3px;text-transform:uppercase;color:#CFE3F0;text-shadow:0 1px 4px rgba(0,0,0,0.45);">Password reset</div>
        <div style="font-size:30px;font-weight:700;line-height:1.2;color:#ffffff;padding-top:4px;text-shadow:0 2px 8px rgba(0,0,0,0.45);">Workout Challenge</div>
      </mj-text>
    </mj-hero>

    <!-- ============ Body ============ -->
    <mj-section padding="30px 0px 0px">
      <mj-column>
        <mj-text>
          <p style="margin:0 0 14px;">Hi {{ first_name }},</p>
          <p style="margin:0 0 20px;">We received a request to reset your password. Use the button below to choose a new one.</p>
        </mj-text>
        <mj-button href="{{ RESET_URL }}" padding="0px 28px" align="left">Reset my password</mj-button>
        <mj-text padding="20px 28px 0px">
          <div style="font-size:13px;color:#5B6875;padding-bottom:8px;">Or paste this link into your browser:</div>
          <table cellpadding="0" cellspacing="0" border="0" width="100%" role="presentation" style="background-color:#F4F7FA;border-radius:10px;">
            <tr>
              <td style="padding:13px 16px;font-size:12px;line-height:1.6;">
                <a href="{{ RESET_URL }}" style="color:#075985;text-decoration:none;font-weight:600;word-break:break-all;">{{ RESET_URL }}</a>
              </td>
            </tr>
          </table>
        </mj-text>
        <mj-text padding="18px 28px 0px" font-size="13px" color="#5B6875">
          The link expires <b style="color:#1F2937;">10 minutes</b> after it was requested. If you didn&rsquo;t ask for a reset you can safely ignore this email &ndash; your password stays unchanged.
        </mj-text>
        <mj-divider />
      </mj-column>
    </mj-section>

    <!-- ============ Sign off ============ -->
    <mj-section padding="0px 0px 30px">
      <mj-column>
        <mj-text>
          <p style="margin:0 0 4px;">Enjoy the competition &ndash; good luck!</p>
          <p style="margin:0;color:#5B6875;font-size:14px;">The Workout Challenge</p>
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- ============ Footer ============ -->
    <mj-section background-color="#E1E8ED" padding="22px 0px 26px">
      <mj-column>
        <mj-text align="center" font-size="12px" line-height="1.7" color="#7A8794">
          <span style="font-weight:700;color:#5B6875;">Workout Challenge</span><br />
          Any issues? <a href="mailto:{{ EMAIL_REPLY_TO }}" style="color:#075985;text-decoration:none;font-weight:600;">Send us an email</a> &nbsp;&middot;&nbsp; <a href="https://github.com/vanalmsick/workout_challenge" style="color:#075985;text-decoration:none;font-weight:600;">Source code</a>
        </mj-text>
      </mj-column>
    </mj-section>

  </mj-body>
</mjml>
