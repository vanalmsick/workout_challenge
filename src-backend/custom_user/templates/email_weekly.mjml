<mjml>
  <!-- Written with https://mjml.io/ - compile with: npx mjml email_weekly.mjml -o email_weekly.html -->
  <mj-head>
    <mj-title>Your weekly check-in</mj-title>
    <mj-preview>Keep the momentum going. Here is your streak and how your personal 7-day goals are tracking.</mj-preview>
    <mj-raw>
      {% load humanize %}
      <meta name="color-scheme" content="light">
      <meta name="supported-color-schemes" content="light">
    </mj-raw>
    <mj-attributes>
      <mj-all font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Ubuntu, Helvetica, Arial, sans-serif" />
      <mj-text font-size="15px" line-height="1.6" color="#1F2937" padding="0px 28px" />
      <mj-section background-color="#ffffff" padding="0px" />
      <mj-column padding="0px" />
      <mj-divider border-color="#E5E7EB" border-width="1px" padding="22px 28px" />
      <mj-button background-color="#075985" color="#ffffff" border-radius="999px" font-size="13px" font-weight="700" inner-padding="13px 30px" padding="0px" />
    </mj-attributes>
  </mj-head>

  <mj-body background-color="#E1E8ED">

    <!-- ============ Hero ============ -->
    <mj-hero mode="fixed-height" height="200px" background-url="{{ MAIN_HOST }}/running_email.jpg" background-color="#075985" padding="0px">
      <mj-text align="center" css-class="no-invert" padding="46px 20px 0px">
        <div style="font-size:11px;font-weight:700;letter-spacing:3px;text-transform:uppercase;color:#CFE3F0;text-shadow:0 1px 4px rgba(0,0,0,0.45);">Weekly check-in</div>
        <div style="font-size:30px;font-weight:700;line-height:1.2;color:#ffffff;padding-top:4px;text-shadow:0 2px 8px rgba(0,0,0,0.45);">Workout Challenge</div>
      </mj-text>
      <mj-button href="{{ MAIN_HOST }}/login" background-color="#ffffff" color="#075985" padding="18px 20px 0px">Open the app</mj-button>
    </mj-hero>

    <!-- ============ Intro ============ -->
    <mj-section padding="30px 0px 0px">
      <mj-column>
        <mj-text>
          <p style="margin:0 0 14px;">Hi {{ first_name }},</p>
          <p style="margin:0 0 16px;">Let's check in on your week &ndash; keep the momentum going and the streak alive.</p>
        </mj-text>
        <mj-text padding="0px 28px">
          <table cellpadding="0" cellspacing="0" border="0" width="100%" role="presentation" style="background-color:#F4F7FA;border-radius:10px;">
            <tr>
              <td style="padding:14px 18px;font-size:13px;line-height:1.55;color:#5B6875;">
                <span style="font-weight:700;letter-spacing:0.8px;text-transform:uppercase;font-size:11px;color:#8A97A4;">WHO recommendation</span><br />
                150&ndash;300 minutes of moderate or 75&ndash;150 minutes of vigorous activity per week (or an equivalent mix), spread across at least two days.
              </td>
            </tr>
          </table>
        </mj-text>
        <mj-divider />
      </mj-column>
    </mj-section>

    <!-- ============ Streak + goals ============ -->
    <mj-section padding="0px 0px 8px">
      <mj-column width="50%">
        <mj-text padding="0px 28px">
          <div style="font-size:17px;font-weight:700;color:#075985;padding-bottom:12px;">&#128293;&nbsp; Your streak</div>
          <table cellpadding="0" cellspacing="0" border="0" width="100%" role="presentation" style="table-layout:fixed;">
            <tr>
              {% for label in "MTWTFSS"|make_list %}
              <td align="center" style="padding:0 0 6px;font-size:11px;font-weight:700;letter-spacing:0.6px;color:#A7B2BC;">{{ label }}</td>
              {% endfor %}
            </tr>
            {% for week in calendar %}
            <tr>
              {% for day in week %}
              <td align="center" style="padding:3px 0;font-size:0;line-height:0;">
                <!--[if mso]><v:roundrect xmlns:v="urn:schemas-microsoft-com:vml" xmlns:w="urn:schemas-microsoft-com:office:word" arcsize="50%" stroke="f" fillcolor="{{ day.background_color }}" style="width:28px;height:28px;v-text-anchor:middle;"><w:anchorlock/><center style="color:{{ day.color }};font-family:'Segoe UI',Arial,sans-serif;font-size:12px;font-weight:700;">{{ day.day }}</center></v:roundrect><![endif]-->
                <!--[if !mso]><!-- -->
                <div style="width:28px;height:28px;line-height:28px;margin:0 auto;border-radius:50%;background-color:{{ day.background_color }};color:{{ day.color }};font-size:12px;font-weight:700;text-align:center;mso-line-height-rule:exactly;">{{ day.day }}</div>
                <!--<![endif]-->
              </td>
              {% endfor %}
            </tr>
            {% endfor %}
          </table>
          <table cellpadding="0" cellspacing="0" border="0" width="100%" role="presentation" style="margin-top:12px;background-color:#F4F7FA;border-radius:10px;">
            <tr>
              <td align="center" style="padding:11px 12px;font-size:13px;font-weight:700;color:#5B6875;">
                <span style="background-color:#6387BC;color:#ffffff;border-radius:999px;padding:2px 8px;font-size:12px;">&#10003;</span>&nbsp;&nbsp;{{ week_streak }} week streak
              </td>
            </tr>
          </table>
          <div style="height:20px;line-height:20px;font-size:0;">&nbsp;</div>
        </mj-text>
      </mj-column>

      <mj-column width="50%">
        <mj-text padding="0px 28px">
          <div style="font-size:17px;font-weight:700;color:#075985;padding-bottom:12px;">Your 7-day goals</div>

          {% if goals.active_days %}
          <table cellpadding="0" cellspacing="0" border="0" width="100%" role="presentation" style="background-color:#F4F7FA;border-radius:10px;">
            <tr>
              <td style="padding:14px 16px;">
                <table cellpadding="0" cellspacing="0" border="0" width="100%" role="presentation">
                  <tr>
                    <td style="font-size:13px;font-weight:700;color:#1F2937;">Active days</td>
                    <td align="right" style="font-size:13px;color:#5B6875;white-space:nowrap;"><b style="color:#075985;">{{ goals.active_days.recorded|intcomma }}</b> / {{ goals.active_days.target|intcomma }}</td>
                  </tr>
                </table>
                <table cellpadding="0" cellspacing="0" border="0" width="100%" role="presentation" bgcolor="#E3E8EE" style="margin-top:9px;background-color:#E3E8EE;border-radius:999px;">
                  <tr>
                    <td width="{{ goals.active_days.percent|floatformat:0 }}%" height="10" bgcolor="#6387BC" style="height:10px;line-height:10px;font-size:0;mso-line-height-rule:exactly;background-color:#6387BC;border-radius:999px;">&nbsp;</td>
                    <td height="10" style="height:10px;line-height:10px;font-size:0;mso-line-height-rule:exactly;">&nbsp;</td>
                  </tr>
                </table>
              </td>
            </tr>
          </table>
          <div style="height:10px;line-height:10px;font-size:0;">&nbsp;</div>
          {% endif %}

          {% if goals.minutes %}
          <table cellpadding="0" cellspacing="0" border="0" width="100%" role="presentation" style="background-color:#F4F7FA;border-radius:10px;">
            <tr>
              <td style="padding:14px 16px;">
                <table cellpadding="0" cellspacing="0" border="0" width="100%" role="presentation">
                  <tr>
                    <td style="font-size:13px;font-weight:700;color:#1F2937;">Exercise</td>
                    <td align="right" style="font-size:13px;color:#5B6875;white-space:nowrap;"><b style="color:#075985;">{{ goals.minutes.recorded|intcomma }}</b> / {{ goals.minutes.target|intcomma }} min</td>
                  </tr>
                </table>
                <table cellpadding="0" cellspacing="0" border="0" width="100%" role="presentation" bgcolor="#E3E8EE" style="margin-top:9px;background-color:#E3E8EE;border-radius:999px;">
                  <tr>
                    <td width="{{ goals.minutes.percent|floatformat:0 }}%" height="10" bgcolor="#6387BC" style="height:10px;line-height:10px;font-size:0;mso-line-height-rule:exactly;background-color:#6387BC;border-radius:999px;">&nbsp;</td>
                    <td height="10" style="height:10px;line-height:10px;font-size:0;mso-line-height-rule:exactly;">&nbsp;</td>
                  </tr>
                </table>
              </td>
            </tr>
          </table>
          <div style="height:10px;line-height:10px;font-size:0;">&nbsp;</div>
          {% endif %}

          {% if goals.distance %}
          <table cellpadding="0" cellspacing="0" border="0" width="100%" role="presentation" style="background-color:#F4F7FA;border-radius:10px;">
            <tr>
              <td style="padding:14px 16px;">
                <table cellpadding="0" cellspacing="0" border="0" width="100%" role="presentation">
                  <tr>
                    <td style="font-size:13px;font-weight:700;color:#1F2937;">Distance</td>
                    <td align="right" style="font-size:13px;color:#5B6875;white-space:nowrap;"><b style="color:#075985;">{{ goals.distance.recorded|floatformat:0|intcomma }}</b> / {{ goals.distance.target|intcomma }} km</td>
                  </tr>
                </table>
                <table cellpadding="0" cellspacing="0" border="0" width="100%" role="presentation" bgcolor="#E3E8EE" style="margin-top:9px;background-color:#E3E8EE;border-radius:999px;">
                  <tr>
                    <td width="{{ goals.distance.percent|floatformat:0 }}%" height="10" bgcolor="#6387BC" style="height:10px;line-height:10px;font-size:0;mso-line-height-rule:exactly;background-color:#6387BC;border-radius:999px;">&nbsp;</td>
                    <td height="10" style="height:10px;line-height:10px;font-size:0;mso-line-height-rule:exactly;">&nbsp;</td>
                  </tr>
                </table>
              </td>
            </tr>
          </table>
          {% endif %}

          {% if not goals.active_days and not goals.minutes and not goals.distance %}
          <div style="font-size:14px;color:#8A97A4;">No personal goals set yet &ndash; add them in your settings to track progress here.</div>
          {% endif %}
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-raw> {% if openai_quote is not None %} </mj-raw>
    <!-- ============ AI health fact ============ -->
    <mj-section padding="18px 0px 0px">
      <mj-column>
        <mj-divider padding="0px 28px 24px" />
      </mj-column>
    </mj-section>
    <mj-section background-color="#075985" padding="30px 0px">
      <mj-column>
        <mj-text align="center" color="#9FC7DE" padding="0px 28px">
          <div style="font-size:11px;font-weight:700;letter-spacing:2.4px;text-transform:uppercase;">Fact of the day</div>
        </mj-text>
        <mj-text align="center" color="#ffffff" font-size="17px" line-height="1.45" padding="12px 34px 0px">
          {{ openai_quote }}
        </mj-text>
        <mj-text align="center" color="#8FB6CD" font-size="11px" padding="14px 28px 0px">
          Generated by OpenAI&rsquo;s ChatGPT
        </mj-text>
      </mj-column>
    </mj-section>
    <mj-raw> {% endif %} </mj-raw>

    <!-- ============ Sign off ============ -->
    <mj-section padding="0px 0px 30px">
      <mj-column>
        <mj-raw> {% if openai_quote is None %} </mj-raw>
        <mj-divider />
        <mj-raw> {% endif %} </mj-raw>
        <mj-text padding="26px 28px 0px">
          <p style="margin:0 0 16px;">Log in for the full picture &ndash; detailed analyses, charts and breakdowns.</p>
        </mj-text>
        <mj-button href="{{ MAIN_HOST }}/login" padding="0px 28px" align="left">Open the app</mj-button>
        <mj-text padding="22px 28px 0px">
          <p style="margin:0 0 4px;">Enjoy the competition &ndash; good luck!</p>
          <p style="margin:0;color:#5B6875;font-size:14px;">The Workout Challenge</p>
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- ============ Footer ============ -->
    <mj-section background-color="#E1E8ED" padding="22px 0px 26px">
      <mj-column>
        <mj-text align="center" font-size="12px" line-height="1.7" color="#7A8794">
          <span style="font-weight:700;color:#5B6875;">Workout Challenge</span><br />
          Any issues? <a href="mailto:{{ EMAIL_REPLY_TO }}" style="color:#075985;text-decoration:none;font-weight:600;">Send us an email</a> &nbsp;&middot;&nbsp; <a href="https://github.com/vanalmsick/workout_challenge" style="color:#075985;text-decoration:none;font-weight:600;">Source code</a>
        </mj-text>
      </mj-column>
    </mj-section>

  </mj-body>
</mjml>
